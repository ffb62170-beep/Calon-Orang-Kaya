<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Naufal Aziz - Retro Portfolio OS</title>
  <!-- Win98 CSS Framework dari CDN resmi -->
  <link rel="stylesheet" href="https://unpkg.com/98.css">
  <style>
    :root {
      --bg-teal: #008080;
      --font-pixel: "Courier New", Courier, monospace;
    }

    * {
      box-sizing: border-box;
      user-select: none;
    }

    body {
      background-color: var(--bg-teal);
      font-family: "Pixelated MS Sans Serif", "MS Sans Serif", Arial, sans-serif;
      height: 100vh;
      margin: 0;
      overflow: hidden;
      position: relative;
    }

    /* CRT Overlay Filter */
    .crt-overlay {
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.2) 50%);
      background-size: 100% 4px;
      z-index: 9999;
      pointer-events: none;
    }

    /* Top Bar Header */
    .system-header {
      background: #c0c0c0;
      border-bottom: 2px solid #808080;
      padding: 4px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: bold;
      font-size: 12px;
      height: 32px;
    }

    /* Desktop Area & Icons */
    .desktop {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex-wrap: wrap;
      align-content: flex-start;
      gap: 20px;
      height: calc(100vh - 72px);
    }

    .icon-btn {
      width: 80px;
      text-align: center;
      cursor: pointer;
      color: white;
      text-shadow: 1px 1px 2px black;
      background: transparent;
      border: none;
      outline: none;
    }

    .icon-btn:focus .icon-text,
    .icon-btn:hover .icon-text {
      background-color: #000080;
      outline: 1px dotted #ffffff;
    }

    .icon-img {
      font-size: 36px;
      display: block;
      margin-bottom: 4px;
    }

    .icon-text {
      font-size: 11px;
      padding: 2px;
      word-wrap: break-word;
    }

    /* Window Positioning */
    .window {
      position: absolute;
      width: 90%;
      max-width: 450px;
      display: none;
      z-index: 10;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
    }

    .window.active {
      display: block;
    }

    .title-bar {
      cursor: move;
    }

    .window-body {
      max-height: 350px;
      overflow-y: auto;
    }

    /* Taskbar & Start Menu */
    .taskbar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      height: 40px;
      background: #c0c0c0;
      border-top: 2px solid #ffffff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 4px;
      z-index: 10000;
    }

    .start-menu {
      position: fixed;
      bottom: 42px;
      left: 4px;
      width: 200px;
      display: none;
      flex-direction: column;
      z-index: 10001;
      background: #c0c0c0;
      padding: 3px;
    }

    .start-menu-item {
      padding: 6px 10px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      font-size: 12px;
    }

    .start-menu-item:hover {
      background: #000080;
      color: white;
    }

    .status-clock {
      padding: 2px 8px;
      font-size: 11px;
    }

    /* Terminal Styles */
    .terminal-body {
      background: #000;
      color: #00ff00;
      font-family: var(--font-pixel);
      padding: 10px;
      min-height: 180px;
      font-size: 12px;
    }

    .terminal-input {
      background: transparent;
      border: none;
      color: #00ff00;
      font-family: var(--font-pixel);
      outline: none;
      width: 70%;
    }
  </style>
</head>
<body>

  <!-- Layar CRT FX -->
  <div class="crt-overlay" id="crtOverlay"></div>

  <!-- Header Atas -->
  <div class="system-header">
    <span>SYSTEM: NAUFAL_AZIZ_OS_v3.1</span>
    <div>
      <label style="margin-right: 8px;"><input type="checkbox" id="toggleSound" checked> 🔊 Suara</label>
      <label><input type="checkbox" id="toggleCRT" checked> 📺 CRT</label>
    </div>
  </div>

  <!-- Desktop Icons -->
  <div class="desktop">
    <button class="icon-btn" onclick="openWindow('win-about')">
      <span class="icon-img">💻</span>
      <span class="icon-text">My_Profile.sys</span>
    </button>
    <button class="icon-btn" onclick="openWindow('win-projects')">
      <span class="icon-img">📁</span>
      <span class="icon-text">Projects.exe</span>
    </button>
    <button class="icon-btn" onclick="openWindow('win-skills')">
      <span class="icon-img">⚡</span>
      <span class="icon-text">Skills.dll</span>
    </button>
    <button class="icon-btn" onclick="openWindow('win-terminal')">
      <span class="icon-img">📟</span>
      <span class="icon-text">MS-DOS.com</span>
    </button>
    <button class="icon-btn" onclick="openWindow('win-contact')">
      <span class="icon-img">📝</span>
      <span class="icon-text">Contact.txt</span>
    </button>
  </div>

  <!-- JENDELA: BIODATA / ABOUT -->
  <div id="win-about" class="window" style="top: 50px; left: 20px;">
    <div class="title-bar" onmousedown="dragWindow(event, 'win-about')">
      <div class="title-bar-text">💾 My_Profile.sys - Naufal Aziz</div>
      <div class="title-bar-controls">
        <button aria-label="Close" onclick="closeWindow('win-about')"></button>
      </div>
    </div>
    <div class="window-body">
      <p><strong>Halo, Saya Naufal Aziz! 👋</strong></p>
      <p>Selamat datang di portofolio pribadi berbasis Web OS Retro.</p>
      <hr>
      <div class="sunken-panel" style="padding: 10px; background: white;">
        <p><strong>Nama Lengkap:</strong> Naufal Aziz</p>
        <p><strong>Tanggal Lahir:</strong> 14 Mei 2011</p>
        <p><strong>Peran:</strong> Web Developer & Creative Technologist</p>
        <p><strong>Fokus:</strong> Full-Stack Development & Interactive Web UI</p>
        <p><strong>Status:</strong> 🟢 Open for Collaboration & Projects</p>
      </div>
      <br>
      <button onclick="playBeep(); alert('Mengunduh CV Naufal Aziz...')">💾 Unduh Resume.pdf</button>
    </div>
  </div>

  <!-- JENDELA: PROYEK -->
  <div id="win-projects" class="window" style="top: 70px; left: 50px;">
    <div class="title-bar" onmousedown="dragWindow(event, 'win-projects')">
      <div class="title-bar-text">📁 Proyek_Utama.exe</div>
      <div class="title-bar-controls">
        <button aria-label="Close" onclick="closeWindow('win-projects')"></button>
      </div>
    </div>
    <div class="window-body">
      <ul class="tree-view">
        <li>
          <strong>1. Retro Web OS Portfolio</strong>
          <p>Portofolio interaktif bernuansa sistem operasi klasik tahun 90-an.</p>
        </li>
        <li>
          <strong>2. E-Commerce Dashboard App</strong>
          <p>Sistem manajemen toko online lengkap dengan analisa grafik penjualan.</p>
        </li>
        <li>
          <strong>3. Interactive Web Game</strong>
          <p>Game edukasi interaktif berbasis pemrograman JavaScript Canvas.</p>
        </li>
      </ul>
    </div>
  </div>

  <!-- JENDELA: KEAHLIAN -->
  <div id="win-skills" class="window" style="top: 90px; left: 80px;">
    <div class="title-bar" onmousedown="dragWindow(event, 'win-skills')">
      <div class="title-bar-text">⚡ Skill_Matrix.dll</div>
      <div class="title-bar-controls">
        <button aria-label="Close" onclick="closeWindow('win-skills')"></button>
      </div>
    </div>
    <div class="window-body">
      <p>HTML5 / CSS3 / JavaScript</p>
      <div class="sunken-panel" style="height: 18px; background: #eee; margin-bottom: 8px;">
        <div style="width: 90%; height: 100%; background: #000080;"></div>
      </div>
      <p>Frontend (React / Modern Web UI)</p>
      <div class="sunken-panel" style="height: 18px; background: #eee; margin-bottom: 8px;">
        <div style="width: 85%; height: 100%; background: #000080;"></div>
      </div>
      <p>Backend Logic & Programming</p>
      <div class="sunken-panel" style="height: 18px; background: #eee; margin-bottom: 8px;">
        <div style="width: 78%; height: 100%; background: #000080;"></div>
      </div>
    </div>
  </div>

  <!-- JENDELA: TERMINAL DOS -->
  <div id="win-terminal" class="window" style="top: 110px; left: 110px;">
    <div class="title-bar" onmousedown="dragWindow(event, 'win-terminal')">
      <div class="title-bar-text">📟 MS-DOS Prompt</div>
      <div class="title-bar-controls">
        <button aria-label="Close" onclick="closeWindow('win-terminal')"></button>
      </div>
    </div>
    <div class="window-body terminal-body" id="terminal-body">
      <p>Naufal Aziz OS [Version 3.10.1998]</p>
      <p>Ketik <span style="color: yellow;">'help'</span> untuk daftar perintah.</p>
      <br>
      <div id="terminal-output"></div>
      <div>
        <span>C:\NAUFAL&gt;</span>
        <input type="text" id="terminal-input" class="terminal-input" autofocus onkeydown="handleTerminal(event)">
      </div>
    </div>
  </div>

  <!-- JENDELA: KONTAK -->
  <div id="win-contact" class="window" style="top: 130px; left: 140px;">
    <div class="title-bar" onmousedown="dragWindow(event, 'win-contact')">
      <div class="title-bar-text">📝 Contact.txt - Notepad</div>
      <div class="title-bar-controls">
        <button aria-label="Close" onclick="closeWindow('win-contact')"></button>
      </div>
    </div>
    <div class="window-body">
      <div class="field-row-stacked">
        <label for="contact-name">Nama Anda:</label>
        <input id="contact-name" type="text" placeholder="Ketik nama..." />
      </div>
      <div class="field-row-stacked" style="margin-top: 6px;">
        <label for="contact-msg">Pesan:</label>
        <textarea id="contact-msg" rows="3" placeholder="Ketik pesan Anda..."></textarea>
      </div>
      <br>
      <button onclick="playBeep(); alert('Pesan berhasil dikirim!');">📧 Kirim Pesan</button>
    </div>
  </div>

  <!-- START MENU -->
  <div id="start-menu" class="start-menu window">
    <div class="start-menu-item" onclick="openWindow('win-about'); toggleStartMenu();">💻 Profil Naufal</div>
    <div class="start-menu-item" onclick="openWindow('win-projects'); toggleStartMenu();">📁 Portofolio Proyek</div>
    <div class="start-menu-item" onclick="openWindow('win-skills'); toggleStartMenu();">⚡ Keahlian</div>
    <div class="start-menu-item" onclick="openWindow('win-terminal'); toggleStartMenu();">📟 Terminal DOS</div>
    <div class="start-menu-item" onclick="openWindow('win-contact'); toggleStartMenu();">📝 Hubungi Naufal</div>
  </div>

  <!-- TASKBAR -->
  <div class="taskbar">
    <button onclick="toggleStartMenu(); playBeep();">
      <strong>🖥️ Start</strong>
    </button>
    <div class="status-clock sunken-panel" id="clock">12:00 PM</div>
  </div>

  <script>
    // Audio Synthesizer Beep
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep() {
      if (!document.getElementById('toggleSound').checked) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'square';
      osc.frequency.value = 600;
      gain.gain.value = 0.05;
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.05);
    }

    // Toggle CRT
    document.getElementById('toggleCRT').addEventListener('change', (e) => {
      document.getElementById('crtOverlay').style.display = e.target.checked ? 'block' : 'none';
    });

    // Window System
    let topZ = 100;
    function openWindow(id) {
      playBeep();
      const win = document.getElementById(id);
      win.classList.add('active');
      win.style.zIndex = ++topZ;
    }

    function closeWindow(id) {
      playBeep();
      document.getElementById(id).classList.remove('active');
    }

    function dragWindow(e, id) {
      const win = document.getElementById(id);
      win.style.zIndex = ++topZ;
      let shiftX = e.clientX - win.getBoundingClientRect().left;
      let shiftY = e.clientY - win.getBoundingClientRect().top;

      function moveAt(pageX, pageY) {
        win.style.left = pageX - shiftX + 'px';
        win.style.top = pageY - shiftY + 'px';
      }

      function onMouseMove(event) {
        moveAt(event.pageX, event.pageY);
      }

      document.addEventListener('mousemove', onMouseMove);

      document.onmouseup = function() {
        document.removeEventListener('mousemove', onMouseMove);
        document.onmouseup = null;
      };
    }

    function toggleStartMenu() {
      const menu = document.getElementById('start-menu');
      menu.style.display = menu.style.display === 'flex' ? 'none' : 'flex';
    }

    // Jam Realtime
    function updateClock() {
      const now = new Date();
      document.getElementById('clock').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Terminal DOS
    function handleTerminal(e) {
      if (e.key === 'Enter') {
        playBeep();
        const input = document.getElementById('terminal-input');
        const output = document.getElementById('terminal-output');
        const cmd = input.value.trim().toLowerCase();

        let res = '';
        if (cmd === 'help') {
          res = 'Perintah: help, about, skills, clear';
        } else if (cmd === 'about') {
          res = 'Naufal Aziz (14 Mei 2011) - Web Developer';
        } else if (cmd === 'skills') {
          res = 'JavaScript, HTML5, CSS3, React, Node.js';
        } else if (cmd === 'clear') {
          output.innerHTML = '';
          input.value = '';
          return;
        } else if (cmd !== '') {
          res = `'${cmd}' tidak dikenali. Ketik 'help'.`;
        }

        output.innerHTML += `<div>C:\\NAUFAL&gt; ${input.value}</div><div>${res}</div><br>`;
        input.value = '';
        document.getElementById('terminal-body').scrollTop = document.getElementById('terminal-body').scrollHeight;
      }
    }
  </script>
</body>
</html>
